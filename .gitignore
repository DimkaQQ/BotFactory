venv/
*.egg-info/

# Env
.env
.env.local

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
.vscode/

# Logs
*.log

# Directly-uploaded media (local dev — see Settings.media_upload_dir;
