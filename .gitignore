/media_uploads/

# Временные пробники проверок: файл, который пишут, чтобы воспроизвести
# находку, и выбрасывают следом. В историю попадать он не должен —
# настоящий тест на подтверждённую находку пишется рядом, в tests/.
tests/zz_*

# Coverage
.coverage
htmlcov/
.ruff_cache/
.pytest_cache/

# Служебные метки скриптов deploy/
.deployfirst.done
.deploy-mode
.deploy-prev
.deploy-running
.deploy-branch
.media_chown_done
backups/
