# Production TLS termination for a VPS deploy. Caddy gets/renews a
# Let's Encrypt certificate for $DOMAIN automatically (needs an A record
# pointing at this server's IP, and ports 80+443 open) and forwards
# everything to the frontend/nginx container, which already knows how to
# route /builder (Mini App), /api/* and /webhook/* to the right place.
{$DOMAIN} {
    encode gzip
    # Mirrors what nginx sets inside the container, so the headers are
    # present whichever entry point a deployment uses.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy frontend:80
}
