# PostgreSQL connection string used by the FastAPI app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://botfactory:botfactory@db:5432/botfactory
# Same DB, but the plain sync DSN alembic needs for migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://botfactory:botfactory@db:5432/botfactory

# Token of the meta-bot (the one users /start first, get from @BotFather).
META_BOT_TOKEN=123456:AAAA-your-meta-bot-token
# Its @username (no @) — used to render the Telegram Login Widget for the
# standalone web version of the constructor (login outside the Mini App).
# Must also have the domain enabled for login in @BotFather: /setdomain.
META_BOT_USERNAME=YourMetaBot

# Only needed if api.telegram.org is blocked/throttled from where this
# server is hosted (common for RU-hosted VPS). Point this at a reverse
# proxy that forwards 1:1 to Telegram's Bot API (e.g. a Cloudflare Worker).
# Leave empty to talk to api.telegram.org directly.
# TELEGRAM_API_BASE_URL=https://your-worker.example.workers.dev

# Public HTTPS base URL of your deployment (Telegram requires HTTPS for both
# WebApp and webhooks). For local dev, point this at your Cloudflare Tunnel URL.
PUBLIC_BASE_URL=https://your-domain.com

# Bare domain (no scheme) that Caddy should get a Let's Encrypt certificate
# for — must match the host part of PUBLIC_BASE_URL above, and have an A
# record pointing at this VPS. Only used by docker-compose.prod.yml (Caddy).
DOMAIN=your-domain.com

# Fernet master key used to encrypt client bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated list of allowed CORS origins for the Mini App, or "*" for local dev.
CORS_ORIGINS=*

# ---- Платная публикация бота (монетизация самой платформы) ----
# Способы оплаты, которые клиент увидит при публикации, одной строкой JSON.
# Их несколько, потому что ни один не покрывает всех: Stripe не работает в
# России и Казахстане (нужна компания в другой юрисдикции), локальный
# эквайринг не берёт зарубежные карты, а криптой можно принимать вообще без
# юрлица. Цена у каждого своя — одна и та же публикация стоит $9, ₸4500 и
# 9 USDT, одним числом это не выразить.
#
# Пустая строка — работают одиночные настройки ниже (совместимость).
# Ни одного способа — публикация бесплатна, пейволл выключен.
#
# Мы принимаем оплату за публикацию только двумя способами: Stripe (карты
# всего мира, на компанию вне РФ и РК) и Crypto Bot (USDT/TON внутри
# Telegram). Оба не зависят от российского или казахстанского эквайринга и
# у обоих нет посредника, который может заблокировать счёт без объяснения.
# Локальные шлюзы (ЮKassa, Payme, Click и т.д.) — это то, что подключают
# себе владельцы ботов; платформа через них деньги не берёт.
#
# renewal_price_minor — сколько стоит следующий период работы бота. Нет
# поля или 0 — платформа берёт деньги только за запуск, дальше бот работает
# бессрочно.
# PLATFORM_PAYMENT_METHODS=[{"provider":"stripe","price_minor":9900,"renewal_price_minor":990,"currency":"USD","credentials":{"secret_key":"sk_live_...","webhook_secret":"whsec_..."}},{"provider":"cryptobot","price_minor":9900,"renewal_price_minor":990,"currency":"USDT","credentials":{"token":"..."}}]
PLATFORM_PAYMENT_METHODS=

# --- Ежемесячная плата за работающего бота ---
# 0 (по умолчанию) — её нет вовсе: заплатили за запуск, бот работает всегда.
# Списаний с сохранённой карты не происходит никогда: бот присылает счёт в
# конструкторе и в Telegram, владелец платит той же кнопкой, что и за
# запуск. Причина в Crypto Bot — у него автосписания нет в принципе, а
# половина клиентов на автосписании и половина на счетах это два разных
# продукта в поддержке.
RENEWAL_PRICE_MINOR=0
# Длина одного оплаченного периода и сколько бот ещё работает после его
# конца, пока владельцу напоминают. Только после грейса бот уходит с эфира —
# и уходит, ничего не удаляя: сценарий, касса и заказы остаются.
RENEWAL_PERIOD_DAYS=30
RENEWAL_GRACE_DAYS=7

# --- Одиночный способ (старый формат, если PLATFORM_PAYMENT_METHODS пуст) ---
# Цена одной публикации в МИНОРНЫХ единицах: 200000 = 2000 ₸ (или 2000 ₽).
# 0 — публикация бесплатна, пейволл полностью выключен.
PUBLICATION_PRICE_MINOR=0
PUBLICATION_CURRENCY=KZT
# Через что платформа принимает эти деньги: stripe | cryptobot | robokassa
# `test` тоже принимается, но только вместе с PLATFORM_ALLOW_TEST_TILL=true —
# он отмечает счёт оплаченным по открытию ссылки, то есть отдаёт публикацию
# даром. Без флага такой способ отключается, и публикация просто остаётся
# бесплатной: потерянная продажа заметна, фальшивая оплата — нет.
PLATFORM_PAYMENT_PROVIDER=stripe
PLATFORM_ALLOW_TEST_TILL=false
# Ключи этого провайдера одной строкой JSON, например:
#   {"secret_key":"sk_live_...","webhook_secret":"whsec_..."}          (stripe)
#   {"merchant_login":"shop","password1":"...","password2":"..."}      (robokassa)
#   {"token":"12345:AA..."}                                            (cryptobot)
PLATFORM_PAYMENT_CREDENTIALS=
# true — платежи тестовые (Robokassa IsTest, Stripe test keys, тестнет Crypto Bot).
PLATFORM_PAYMENT_IS_TEST=true

# --- Бэкапы и мониторинг (deploy/backup.sh, deploy/watchdog.sh) ---
# Твой Telegram id — куда приходят архивы и тревоги. Узнать: @userinfobot.
BACKUP_CHAT_ID=
# Пароль от архива. В нём лежит .env, а в нём FERNET_KEY — без шифрования
# такой файл отдавать нельзя, поэтому без пароля backup.sh не запустится.
# Потеряешь пароль — бэкапы станут нечитаемым мусором.
BACKUP_PASSPHRASE=
# Необязательно: адрес «я жив» (healthchecks.io, Better Stack). Нужен,
# потому что сторож живёт на том же сервере и о смерти сервера сообщить не
# может — об этом скажет молчание пульса. Подробности в deploy/ops.md.
HEARTBEAT_URL=

# Directly-uploaded media (image/video blocks — the alternative to pasting
# a link). Defaults are fine for most deployments; raise the cap if you
# want bigger direct uploads (also bump client_max_body_size in
# nginx/default.conf and deploy/nginx-vhost.example.conf to match).
# MEDIA_UPLOAD_DIR=media_uploads
# MEDIA_MAX_UPLOAD_MB=20

# Used only by docker-compose to provision the Postgres container.
POSTGRES_USER=botfactory
POSTGRES_PASSWORD=botfactory
POSTGRES_DB=botfactory

# Only needed if containers time out on outbound HTTPS (e.g. to
# api.telegram.org) while everything else works — check with:
#   ip link show <your-default-interface>
# If it reports mtu below 1500, set this to that number (commonly 1450 on
# VPS hosts with an SDN/overlay network) and recreate the network:
#   docker compose down && docker compose ... up -d
# DOCKER_NETWORK_MTU=1450
