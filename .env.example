# PostgreSQL connection string used by the FastAPI app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://botfactory:botfactory@db:5432/botfactory
# Same DB, but the plain sync DSN alembic needs for migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://botfactory:botfactory@db:5432/botfactory

# Token of the meta-bot (the one users /start first, get from @BotFather).
META_BOT_TOKEN=123456:AAAA-your-meta-bot-token

# Public HTTPS base URL of your deployment (Telegram requires HTTPS for both
# WebApp and webhooks). For local dev, point this at your Cloudflare Tunnel URL.
PUBLIC_BASE_URL=https://your-domain.com

# Fernet master key used to encrypt client bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated list of allowed CORS origins for the Mini App, or "*" for local dev.
CORS_ORIGINS=*

# Used only by docker-compose to provision the Postgres container.
POSTGRES_USER=botfactory
POSTGRES_PASSWORD=botfactory
POSTGRES_DB=botfactory
